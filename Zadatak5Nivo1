import signal
from functools import wraps
import time


class TimeoutError(Exception):
    pass

def timeout(seconds=2):
  
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
           
            def _timeout_handler(signum, frame):
                raise TimeoutError(f"Funkcija {func.__name__} traje duže od {seconds} sekundi")
            
         
            old_handler = signal.signal(signal.SIGALRM, _timeout_handler)
            signal.alarm(seconds)
            
            try:
                result = func(*args, **kwargs)
                signal.alarm(0)  # Otkaži alarm
                return result
            except TimeoutError:
                wrapper.timeout_occurred = True
                return None
            finally:
                signal.alarm(0)
                signal.signal(signal.SIGALRM, old_handler)
        
        wrapper.timeout_occurred = False
        return wrapper
    return decorator



class FileServerWithDelay(FileServer):
    def __init__(self, name: str, root_dir: str, delay_seconds: float = 0):
        super().__init__(name, root_dir)
        self.delay_seconds = delay_seconds
    
    def read_file(self, relative_path: str) -> Optional[str]:
        if self.delay_seconds > 0:
            time.sleep(self.delay_seconds)  # Simulacija sporog odgovora
        return super().read_file(relative_path)
    
    def get_closest_existing_path(self, relative_path: str) -> str:
        if self.delay_seconds > 0:
            time.sleep(self.delay_seconds)
        return super().get_closest_existing_path(relative_path)



class DistributedFSMiddlewareWithTimeout(DistributedFSMiddleware):
    def __init__(self):
        super().__init__()
        self.timeout_seconds = 2
    
    @timeout(2)  # Dekorator za timeout
    def _call_server_read(self, server: FileServer, rel_path: str) -> Optional[str]:
        """Timeout-ovani poziv server.read_file()"""
        return server.read_file(rel_path)
    
    @timeout(2)
    def _call_server_closest(self, server: FileServer, rel_path: str) -> str:
       
        return server.get_closest_existing_path(rel_path)
    
    def read_file(self, full_path: str) -> Tuple[Optional[str], Optional[str]]:
        
        server, rel_path = self._find_server_for_path(full_path)
        if server is None:
            return None, ""  # server ne postoji
        
      
        content = self._call_server_read(server, rel_path)
        
     
        if hasattr(self._call_server_read, 'timeout_occurred') and self._call_server_read.timeout_occurred:
            self._call_server_read.timeout_occurred = False  # Reset za sledeći poziv
            return None, "Vreme čekanja isteklo"
        
        if content is not None:
            return content, None
        
      
        closest = self._call_server_closest(server, rel_path)
        
        if hasattr(self._call_server_closest, 'timeout_occurred') and self._call_server_closest.timeout_occurred:
            self._call_server_closest.timeout_occurred = False
            return None, "Vreme čekanja isteklo"
        
        if closest:
            closest_full = f"/{server.name}/{closest}" if closest else f"/{server.name}"
        else:
            closest_full = f"/{server.name}"
        
        return None, closest_full
    
    def register_server(self, server_name: str, root_dir: str, delay_seconds: float = 0) -> None:
        
        server = FileServerWithDelay(server_name, root_dir, delay_seconds)
        self.servers[server_name] = server
        self._scan_and_map(server_name)



class DistributedFSClientWithTimeout(DistributedFSClient):
    def get_file(self, path: str) -> str:
        content, closest = self.mw.read_file(path)
        if content is not None:
            return f" Sadržaj fajla '{path}':\n{content}"
        elif closest == "Vreme čekanja isteklo":
            return f" Vreme čekanja isteklo za fajl '{path}' - server ne odgovara."
        else:
            return f" Fajl '{path}' ne postoji. Najbliža postojeća putanja: '{closest}'"



