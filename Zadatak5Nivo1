import threading

class TimeoutFunction:
    
    def __init__(self, func, timeout_seconds):
        self.func = func
        self.timeout_seconds = timeout_seconds
        self.result = None
        self.error = None
        self.timed_out = False
    
    def _target(self, args, kwargs):
        try:
            self.result = self.func(*args, **kwargs)
        except Exception as e:
            self.error = e
    
    def call(self, *args, **kwargs):
        thread = threading.Thread(target=self._target, args=(args, kwargs))
        thread.daemon = True
        thread.start()
        thread.join(self.timeout_seconds)
        
        if thread.is_alive():
            self.timed_out = True
            return None
        if self.error:
            raise self.error
        return self.result



def timeout_thread(seconds=2):
    def decorator(func):
        @wraps(func)
        def wrapper(*args, **kwargs):
            tf = TimeoutFunction(func, seconds)
            result = tf.call(*args, **kwargs)
            if tf.timed_out:
                wrapper.timeout_occurred = True
                return None
            wrapper.timeout_occurred = False
            return result
        wrapper.timeout_occurred = False
        return wrapper
    return decorator

class DistributedFSMiddlewareThreadTimeout(DistributedFSMiddleware):
    def __init__(self):
        super().__init__()
        self.timeout_seconds = 2
    
    @timeout_thread(2)
    def _call_server_read(self, server, rel_path):
        return server.read_file(rel_path)
    
    @timeout_thread(2)
    def _call_server_closest(self, server, rel_path):
        return server.get_closest_existing_path(rel_path)
    
   
    def read_file(self, full_path: str):
        server, rel_path = self._find_server_for_path(full_path)
        if server is None:
