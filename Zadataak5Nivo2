def example_timeout():
    print("\n" + "="*60)
    print("PRIMER 3: ASINHRONI ZAHTEV SA TIMEOUT-OM")
    print("="*60)
    
  
    mw = DistributedFSMiddleware(request_timeout=2.0)
    mw.register_server("server1", "./data/server1", processing_delay=3.0)  # Spor server
    
    mw.write_file_sync("/server1/slow.txt", "Ovaj fajl se sporo čita")
    
    client = DistributedFSClient(mw)
    
    results = []
    
    def timeout_callback(response):
        results.append(response)
        print(f"\n Callback za {response['request_id'][:8]}...")
        if response.get('message'):
            print(f"    {response['message']}")
        elif response['success']:
            print(f"    Sadržaj: {response['content']}")
        else:
            print(f"    Greška: {response}")
    
    print(" Klijent šalje zahtev za sporim serverom (3s obrada, timeout 2s)")
    request_id = client.search_file_async("/server1/slow.txt", timeout_callback)
    print(f" Odmah dobijen odgovor: 'Zahtev primljen' (ID: {request_id[:8]}...)")
    
    
    print("\n Čekanje 4 sekunde da timeout istekne...")
    time.sleep(4)
    
    if results:
        print("\n Callback je pozvan sa timeout porukom")


